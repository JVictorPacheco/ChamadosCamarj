{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "dotnet-context": {
      "type": "local",
      "command": ["npx", "dotnet-context-mcp@0.2.0"],
      "description": "Analisa solução .NET com Roslyn: DbContexts, entidades, migrations, DI",
      "enabled": true
    }
  },
  "agent": {
    "spec": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-flash",
      "description": "Cria specs SDD — rápido e barato",
      "temperature": 0.2,
      "steps": 5,
      "permission": {
        "edit": "allow",
        "bash": "deny"
      }
    },
    "build-backend": {
      "mode": "primary",
      "model": "opencode-go/kimi-k2.7-code",
      "description": "Implementa C#, .NET, EF Core, CQRS",
      "temperature": 0.1,
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "build-frontend": {
      "mode": "primary",
      "model": "opencode-go/kimi-k2.7-code",
      "description": "Implementa React, TypeScript, Tailwind, shadcn",
      "temperature": 0.1,
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "review": {
      "mode": "subagent",
      "model": "opencode-go/kimi-k2.7-code",
      "description": "Revisão de código, segurança e boas práticas",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "explorar": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "description": "Explora o código, busca referências",
      "temperature": 0,
      "permission": {
        "edit": "deny",
        "bash": "allow"
      }
    }
  }
}
